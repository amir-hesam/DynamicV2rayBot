# ==============================================================
# Apache Configuration for Shared cPanel Hosting (Without SSH)
# ==============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Protect sensitive files and directories from web access
    #    (cron/ and cronbot/ stay reachable on purpose: they are the web-cron
    #     entry points and are protected by the cron_secret_key check inside)
    RewriteRule ^(database|config|src|views|storage|vendor)/ - [F,L]
    RewriteRule ^public/storage/ - [F,L]
    RewriteRule \.(db|sqlite|sql|log|env|json|md|lock|bak|old)$ - [F,L]

    # 2. Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route all other requests through index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Fallback security if mod_rewrite is disabled
<FilesMatch "\.(db|sqlite|sql|log|env|json|lock|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes
